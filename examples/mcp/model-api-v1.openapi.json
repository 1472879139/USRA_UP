{
  "openapi": "3.1.0",
  "info": {
    "title": "USRA模型服务与应用交接API",
    "version": "1.0.0",
    "description": "专用/通用模型统一契约。应用负责DeepSeek与兜底，服务不隐式换模型。默认无外部真值评价。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18767",
      "description": "本机模拟/SSH转发；远程真实入口使用HTTPS"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "服务存活与API版本；不证明模型精度或CUDA当前可用",
        "responses": {
          "200": {
            "description": "Health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "查询能力、输入条件、模型版本与显式模拟标志",
        "responses": {
          "200": {
            "description": "Catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tools": {
      "get": {
        "summary": "分页查询工具、启停状态、输入和预期输出契约",
        "responses": {
          "200": {
            "description": "ToolCatalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolCatalog"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      }
    },
    "/v1/tools/{tool_id}": {
      "get": {
        "summary": "查询已登记且未移出的工具契约；停用工具仍可查看",
        "responses": {
          "200": {
            "description": "ToolContract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolContract"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "tool_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        ]
      }
    },
    "/v1/inputs": {
      "post": {
        "summary": "上传TIFF，返回不可变输入ID；像元级预检在任务中执行",
        "responses": {
          "201": {
            "description": "Input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Input"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "image/tiff": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 16777216
              }
            }
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "summary": "显式提交一个模型任务；幂等重试不会重复运行GPU",
        "responses": {
          "202": {
            "description": "Job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{16,128}$"
            }
          }
        ]
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "summary": "查询本身份任务；重启后仍可查询",
        "responses": {
          "200": {
            "description": "Job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ]
      }
    },
    "/v1/jobs/{job_id}/cancel": {
      "post": {
        "summary": "取消排队或运行任务；终态保持原样",
        "responses": {
          "200": {
            "description": "Job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyObject"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ]
      }
    },
    "/v1/artifacts/{artifact_id}": {
      "get": {
        "summary": "下载本身份产物；服务器与SDK均核对SHA256",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "产物原始字节",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "查询本接口契约",
        "responses": {
          "200": {
            "description": "OpenAPI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAPI"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Metadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor",
          "product_level",
          "encoding",
          "bands"
        ],
        "properties": {
          "sensor": {
            "const": "Sentinel-2"
          },
          "product_level": {
            "const": "L2A"
          },
          "encoding": {
            "enum": [
              "dn_10000",
              "reflectance_0_1"
            ]
          },
          "bands": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "enum": [
                "B1",
                "B2",
                "B3",
                "B4",
                "B5",
                "B6",
                "B7",
                "B8",
                "B8A",
                "B9",
                "B11",
                "B12"
              ]
            }
          }
        }
      },
      "JobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "input_id",
          "metadata"
        ],
        "properties": {
          "capability_id": {
            "enum": [
              "da-v2-field-delineation",
              "terramind-small-landcover"
            ]
          },
          "input_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "job_id",
          "status",
          "capability_id",
          "input_id",
          "error",
          "result"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "capability_id": {
            "type": "string"
          },
          "input_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "cancelling",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "object",
              "null"
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Result"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Input": {
        "type": "object",
        "required": [
          "input_id",
          "sha256",
          "size_bytes",
          "created_at"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Catalog": {
        "type": "object",
        "required": [
          "api_version",
          "execution_mode",
          "capabilities",
          "implicit_model_fallback"
        ],
        "properties": {
          "api_version": {
            "const": "1.0.0"
          },
          "execution_mode": {
            "enum": [
              "gpu",
              "mock"
            ]
          },
          "implicit_model_fallback": {
            "const": false
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            }
          }
        }
      },
      "Capability": {
        "type": "object",
        "required": [
          "id",
          "task",
          "tier",
          "model",
          "model_revision",
          "input",
          "outputs",
          "availability",
          "classes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "specialist",
              "general"
            ]
          },
          "model": {
            "type": "string"
          },
          "model_revision": {
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "classes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "availability": {
            "enum": [
              "ready",
              "configured",
              "unavailable"
            ]
          }
        }
      },
      "Artifact": {
        "type": "object",
        "required": [
          "artifact_id",
          "name",
          "sha256",
          "size_bytes",
          "media_type",
          "role",
          "download_path"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{1,96}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string"
          },
          "role": {
            "enum": [
              "classification",
              "field_boundaries",
              "statistics",
              "preview",
              "provenance"
            ]
          },
          "download_path": {
            "type": "string",
            "pattern": "^/v1/artifacts/[0-9a-f]{32}$"
          }
        }
      },
      "Statistic": {
        "type": "object",
        "required": [
          "code",
          "name",
          "pixels",
          "area_m2",
          "fraction"
        ],
        "properties": {
          "code": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "pixels": {
            "type": "integer",
            "minimum": 0
          },
          "area_m2": {
            "type": "number",
            "minimum": 0
          },
          "fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "execution_mode",
          "quality_status",
          "accuracy_evaluated",
          "capability_id",
          "model",
          "model_revision",
          "input_sha256",
          "width",
          "height",
          "crs",
          "transform",
          "valid_pixels",
          "pixel_area_m2",
          "classes",
          "statistics",
          "model_run",
          "warnings",
          "artifacts"
        ],
        "properties": {
          "execution_mode": {
            "enum": [
              "gpu",
              "mock"
            ]
          },
          "quality_status": {
            "enum": [
              "synthetic_demo",
              "unverified_candidate"
            ]
          },
          "accuracy_evaluated": {
            "const": false
          },
          "capability_id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "model_revision": {
            "type": "string"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "crs": {
            "type": "string"
          },
          "transform": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": {
              "type": "number"
            }
          },
          "valid_pixels": {
            "type": "integer",
            "minimum": 1
          },
          "pixel_area_m2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "classes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "statistics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Statistic"
            }
          },
          "model_run": {
            "type": "object"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Artifact"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "api_version",
          "execution_mode"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "degraded"
            ]
          },
          "api_version": {
            "const": "1.0.0"
          },
          "execution_mode": {
            "enum": [
              "gpu",
              "mock"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "api_version",
          "error"
        ],
        "properties": {
          "api_version": {
            "const": "1.0.0"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "EmptyObject": {
        "type": "object",
        "additionalProperties": false
      },
      "OpenAPI": {
        "type": "object"
      },
      "ToolContract": {
        "type": "object",
        "required": [
          "tool_id",
          "mcp_name",
          "capability",
          "metadata_schema",
          "result_schema",
          "registry_revision"
        ],
        "properties": {
          "tool_id": {
            "type": "string"
          },
          "mcp_name": {
            "type": "string"
          },
          "capability": {
            "$ref": "#/components/schemas/Capability"
          },
          "metadata_schema": {
            "type": "object"
          },
          "job_schema": {
            "type": "object"
          },
          "result_schema": {
            "type": "object"
          },
          "registry_revision": {
            "type": "string"
          }
        }
      },
      "ToolCatalog": {
        "type": "object",
        "required": [
          "tools",
          "registry_revision",
          "total",
          "has_more",
          "next_offset"
        ],
        "properties": {
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolContract"
            }
          },
          "registry_revision": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "has_more": {
            "type": "boolean"
          },
          "next_offset": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
